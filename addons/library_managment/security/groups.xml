<?xml version="1.0" encoding="utf-8"?>
<odoo>

   
    <record id="group_library_user" model="res.groups">
        <field name="name">Library User</field>
    </record>

   
    <record id="group_library_manager" model="res.groups">
        <field name="name">Library Manager</field>
    </record>

    <!-- Library User: can read and create records -->
    <record id="library_book_user_rule" model="ir.rule">
        <field name="name">Library User Rule</field>
        <field name="model_id" ref="model_library_book"/>
        <field name="domain_force">[('state', '!=', 'lost')]</field>
        <field name="groups" eval="[(4, ref('library_managment.group_library_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>   
    </record>

    <!-- Library Manager: full access -->
    <record id="library_book_manager_rule" model="ir.rule">
        <field name="name">Library Manager Rule</field>
        <field name="model_id" ref="model_library_book"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('library_managment.group_library_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/> 
    </record>

</odoo>
