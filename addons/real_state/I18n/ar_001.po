"        <br/><br/>\n"
"        Thanks,\n"
"        <t t-if=\"not is_html_empty(object.user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <br/><br/>\n"
"            <t t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/>Mitchell Admin</t>\n"
"        </t>\n"
"        <br/><br/>\n"
"    \n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        مرحباً،\n"
"        <br/><br/>\n"
"        <span style=\"font-weight: bold;\" t-out=\"object.user_id.name\"/> قد طلب تفعيل تطبيق <span style=\"font-weight: bold;\" t-out=\"object.module_id.shortdesc\"/>هذا التطبيق مشمول في اشتراكك <span style=\"color: #875A7B; font-weight: bold;\">دون أي تكاليف إضافية</span>، ولكن يتطلب دور المدير لتفعيله.\n"
"        <br/><br/>\n"
"        </p><blockquote data-o-mail-quote-node=\"1\" data-o-mail-quote=\"1\">\n"
"            <t t-out=\"object.body_html\"/>\n"
"        </blockquote>\n"
"        <br data-o-mail-quote=\"1\"/><br data-o-mail-quote=\"1\"/>\n"
"        <a style=\"background-color:#875A7B; padding:8px 16px 8px 16px; text-decoration:none; color:#fff; border-radius:5px\" t-attf-href=\"/odoo/{{ object.module_id.id }}/action-base_install_request.action_base_module_install_review?menu_id={{ ctx['menu_id'] }}\">مراجعة الطلب</a>\n"
"        <br/><br/>\n"
"        شكراً لك،\n"
"        <t t-if=\"not is_html_empty(object.user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <br/><br/>\n"
"            <t t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/>ميتشل آدمن</t>\n"
"        </t>\n"
"        <br/><br/>\n"
"    \n"
"</div>\n"
"            "

