<odoo>
    <data>
        <record id= "univesity_student_form_view" model = "ir.ui.view">
            <field name="name">university.student.form</field>
            <field name= "model"> university.student</field>
            <field name="arch" type="xml">
                <form string= "university student">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="age"/>
                                <field name="email"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="enrollment_date"/>
                                <field name="birth_date"/>
                                <field name="gender"/>
                                <field name="profile_picture"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id= "univesity_student_list_view" model = "ir.ui.view">
            <field name="name">university.student.list</field>
            <field name= "model"> university.student</field>
            <field name="arch" type="xml">
                <list string= "university student">
                    <field name="name"/>
                    <field name="age"/>
                    <field name="email"/>
                    <field name="active"/>
                    <field name="enrollment_date"/>
                    <field name="birth_date"/>
                    <field name="gender"/>
                </list>
            </field>
        </record>
        <record id="university_student_action" model="ir.actions.act_window">
            <field name="name">University Student Action</field>
            <field name="res_model">university.student</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="university_student_action2" model="ir.actions.act_window">
            <field name="name">University Student Action</field>
            <field name="res_model">university.student</field>
            <field name="view_mode">list</field>
        </record>
        <menuitem id="university_student_menu" name="University Students" action="university_student_action"/>
    </data>
</odoo>